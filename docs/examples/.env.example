# Example environment variables for n8n frontend isolation setup

# ============================================================================
# Next.js Application Environment Variables
# ============================================================================

# The URL where your n8n backend API is running
N8N_BACKEND_URL=http://localhost:5678

# ============================================================================
# n8n Frontend Build Environment Variables
# ============================================================================

# Base API URL for the n8n frontend to connect to the backend
# This is used during the frontend build process
VUE_APP_URL_BASE_API=http://localhost:5678/

# Public path for the built frontend assets
# Use this if you're serving the frontend from a subdirectory
# VUE_APP_PUBLIC_PATH=/n8n-editor/

# ============================================================================
# n8n Backend Environment Variables
# ============================================================================

# The URL of your Next.js application (where the frontend is hosted)
# This is used for CORS configuration
N8N_EDITOR_BASE_URL=http://localhost:3000

# Base URL for webhooks
WEBHOOK_URL=http://localhost:5678/

# WebSocket push backend (required for real-time updates)
N8N_PUSH_BACKEND=websocket

# Database configuration
DB_TYPE=sqlite
# For PostgreSQL:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=n8n

# Security
N8N_BASIC_AUTH_ACTIVE=false
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=password

# Execution mode
EXECUTIONS_MODE=regular
# For queue mode (scalable):
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=localhost
# QUEUE_BULL_REDIS_PORT=6379

# ============================================================================
# Production Environment Variables (examples)
# ============================================================================

# Production Next.js app
# N8N_BACKEND_URL=https://api.yourdomain.com

# Production frontend build
# VUE_APP_URL_BASE_API=https://api.yourdomain.com/

# Production backend
# N8N_EDITOR_BASE_URL=https://app.yourdomain.com
# WEBHOOK_URL=https://api.yourdomain.com/
# N8N_PROTOCOL=https
# N8N_HOST=api.yourdomain.com
# N8N_PORT=443

# ============================================================================
# Optional Configuration
# ============================================================================

# Timezone
GENERIC_TIMEZONE=America/New_York

# Log level
N8N_LOG_LEVEL=info

# Execution data
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Metrics (if using Prometheus)
# N8N_METRICS=true
